# xen-mon settings. Save as .env next to docker-compose.yml.

# --- Pools -------------------------------------------------------------
# One block per pool. URL = the pool master's management IP or hostname
# (the XCP-ng host itself, not XOA). Every host in the pool is found
# automatically. Add XEN_POOL2_..., XEN_POOL3_... for more pools.
XEN_POOL1_URL=https://POOL-MASTER-IP
XEN_POOL1_USERNAME=root
XEN_POOL1_PASSWORD=changeme
# XEN_POOL1_NAME=production      # optional display name (default: pool name, or master's host name)
# XEN_POOL1_VERIFY_SSL=false     # set true if your hosts have trusted certificates

# XEN_POOL2_URL=https://10.0.0.20
# XEN_POOL2_USERNAME=root
# XEN_POOL2_PASSWORD=changeme

# Seconds between polls
XEN_INTERVAL=30

# --- Grafana -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_PORT=3000

# --- Prometheus (UI bound to localhost by default; 0.0.0.0 to expose) ---
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# --- Images ------------------------------------------------------------
# Pin a release (e.g. 0.3.0) instead of latest for reproducible installs.
XEN_MON_VERSION=latest
# XEN_MON_REGISTRY=docker.io/mspencerl87   # pull from Docker Hub instead of ghcr.io
