          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(xen_pool_info, pool)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(xen_pool_info, pool)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "hide": 0,
        "current": {}
      },
      {
        "name": "vm",
        "label": "VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(xen_vm_info{pool=\"$pool\"}, vm)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(xen_vm_info{pool=\"$pool\"}, vm)",
        "refresh": 2,
        "sort": 1,
